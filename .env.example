# Database Configuration
# Get this from your Neon PostgreSQL database dashboard
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Better Auth Configuration
# The base URL for your application (used by Better Auth)
# For development: http://localhost:5173
# For production: https://yourdomain.com
PUBLIC_BETTER_AUTH_BASE_URL="http://localhost:5173"

# Better Auth Secret Key
# Generate a secure random string for JWT signing
# You can generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key-here-change-this-in-production"

# Vercel Blob Storage
# Get this token from your Vercel dashboard under Storage → Blob
# Required for file uploads to work
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# Production App URL (optional)
# Your production domain URL for CORS and other configurations
PUBLIC_APP_URL="https://yourdomain.com"